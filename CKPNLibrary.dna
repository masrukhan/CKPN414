<DnaLibrary Name="CKPN PSAK 414" RuntimeVersion="v4.0" xmlns="http://schemas.excel-dna.net/addin/2020/07/dnalibrary">
  <ExternalLibrary Path="CKPNLibrary.dll" LoadFromBytes="true" Pack="true" />

  <!-- WebView2 (managed) ikut di-pack ke dalam .xll.
       WebView2Loader.dll (native) TIDAK di sini — diembed sebagai resource
       dan diekstrak oleh NativeLoader. -->
